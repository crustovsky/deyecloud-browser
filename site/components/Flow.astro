---
// Four arc gauges (solar, grid, battery, house) joined by dotted wires, in the
// style of the inverter's own panel. Built in the browser from /api/latest.
---
<div id="flow" class="card flow"></div>

<style is:global>
  .flow { padding: 8px 6px; }
  .flow svg { width: 100%; height: auto; display: block; max-width: 700px; margin: 0 auto; }
  .flow .track { fill: none; stroke: var(--track); stroke-width: 11; stroke-linecap: round; }
  .flow .fill { fill: none; stroke-width: 11; stroke-linecap: round; transition: stroke-dasharray 0.6s ease; }
  .flow .wire { fill: none; stroke: var(--text-3); stroke-width: 2; stroke-dasharray: 3 7; stroke-linecap: round; opacity: 0.7; }
  .flow .wire.fwd { animation: flow-fwd 0.9s linear infinite; opacity: 1; }
  .flow .wire.rev { animation: flow-rev 0.9s linear infinite; opacity: 1; }
  .flow .inverter rect { fill: var(--surface); stroke: var(--accent); stroke-width: 2; }
  .flow .icon { fill: none; stroke: var(--text); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .flow .icon .solid { fill: var(--text); stroke: none; }
  .flow .value { font-size: 21px; font-weight: 650; fill: var(--text); font-variant-numeric: tabular-nums; }
  .flow .unit { font-size: 11px; fill: var(--text-3); }
  .flow .name { font-size: 13px; fill: var(--text-2); }
  .flow .tick { font-size: 10px; fill: var(--text-3); }
  .flow .soc { font-size: 15px; font-weight: 650; fill: var(--battery); }
  @keyframes flow-fwd { to { stroke-dashoffset: -20; } }
  @keyframes flow-rev { to { stroke-dashoffset: 20; } }
  @media (prefers-reduced-motion: reduce) { .flow .wire { animation: none !important; } }
</style>

<script>
  import { api, cssVar, type AppConfig, type Reading } from "../lib/api";

  const R = 62;
  const SWEEP = 270;
  const ARC_LEN = (SWEEP / 360) * 2 * Math.PI * R;
  const NODES = {
    pv: { cx: 110, cy: 115, name: "Solar", color: "--pv" },
    grid: { cx: 530, cy: 115, name: "Grid", color: "--grid" },
    battery: { cx: 110, cy: 335, name: "Battery", color: "--battery" },
    load: { cx: 530, cy: 335, name: "House", color: "--load" },
  } as const;
  type Key = keyof typeof NODES;

  const ICONS: Record<Key, string> = {
    pv: `<rect x="3" y="13" width="18" height="8" rx="1"/><path d="M9 13v8M15 13v8M3 17h18"/><circle cx="12" cy="5.5" r="2.3"/><path d="M12 1v1.3M12 8.7V10M7.5 5.5H6.2M17.8 5.5h-1.3M8.8 2.3l.9.9M15.2 2.3l-.9.9"/>`,
    grid: `<path d="M9.5 22L11 4h2l1.5 18M7 8h10M5.5 13h13M9 13l-3 9M15 13l3 9M11 4l-2.5 4M13 4l2.5 4"/>`,
    battery: `<rect x="2" y="7" width="18" height="10" rx="2"/><path d="M22 10.5v3"/><rect class="solid" id="batt-fill" x="4" y="9" width="14" height="6" rx="1"/>`,
    load: `<path d="M3 11.5L12 4l9 7.5"/><path d="M5.5 10v11h13V10"/><path d="M10 21v-6h4v6"/>`,
  };

  function pt(cx: number, cy: number, deg: number): [number, number] {
    const a = (deg * Math.PI) / 180;
    return [cx + R * Math.cos(a), cy + R * Math.sin(a)];
  }

  function arc(cx: number, cy: number): string {
    const [x0, y0] = pt(cx, cy, 135);
    const [x1, y1] = pt(cx, cy, 45);
    return `M${x0.toFixed(1)} ${y0.toFixed(1)} A${R} ${R} 0 1 1 ${x1.toFixed(1)} ${y1.toFixed(1)}`;
  }

  function gauge(key: Key): string {
    const n = NODES[key];
    const [x0, y0] = pt(n.cx, n.cy, 135);
    const [x1, y1] = pt(n.cx, n.cy, 45);
    const d = arc(n.cx, n.cy);
    return `
      <g id="node-${key}">
        <path class="track" d="${d}"/>
        <path class="fill" id="fill-${key}" d="${d}" stroke="var(${n.color})" stroke-dasharray="0 ${ARC_LEN.toFixed(1)}"/>
        <g class="icon" transform="translate(${n.cx - 19} ${n.cy - 26}) scale(1.6)">${ICONS[key]}</g>
        ${key === "battery" ? `<text class="soc" id="soc" x="${n.cx}" y="${n.cy - 30}" text-anchor="middle"></text>` : ""}
        <text class="value" id="val-${key}" x="${n.cx}" y="${n.cy + 36}" text-anchor="middle">–</text>
        <text class="unit" x="${n.cx}" y="${n.cy + 50}" text-anchor="middle">kW</text>
        <text class="tick" x="${x0 - 2}" y="${y0 + 14}" text-anchor="middle">0</text>
        <text class="tick" id="max-${key}" x="${x1 + 2}" y="${y1 + 14}" text-anchor="middle"></text>
        <text class="name" id="name-${key}" x="${n.cx}" y="${n.cy + R + 30}" text-anchor="middle">${n.name}</text>
      </g>`;
  }

  // Wires run from each node to the inverter box in the middle. Path direction is
  // node -> inverter, so "fwd" animates power flowing into the inverter and "rev" out of it.
  const BOX = { cx: 320, cy: 225, half: 30 };

  function wires(): string {
    const l = NODES.pv.cx + R + 8;
    const r = NODES.grid.cx - R - 8;
    const yT = NODES.pv.cy;
    const yB = NODES.battery.cy;
    const xl = 250;
    const xr = 390;
    const q = 14;
    const off = 12; // the two left wires enter the box at different heights so they never overlap
    const yU = BOX.cy - off;
    const yD = BOX.cy + off;
    const bl = BOX.cx - BOX.half;
    const br = BOX.cx + BOX.half;
    return `
      <path class="wire" id="wire-pv" d="M${l} ${yT} H${xl - q} Q${xl} ${yT} ${xl} ${yT + q} V${yU - q} Q${xl} ${yU} ${xl + q} ${yU} H${bl}"/>
      <path class="wire" id="wire-battery" d="M${l} ${yB} H${xl - q} Q${xl} ${yB} ${xl} ${yB - q} V${yD + q} Q${xl} ${yD} ${xl + q} ${yD} H${bl}"/>
      <path class="wire" id="wire-grid" d="M${r} ${yT} H${xr + q} Q${xr} ${yT} ${xr} ${yT + q} V${yU - q} Q${xr} ${yU} ${xr - q} ${yU} H${br}"/>
      <path class="wire" id="wire-load" d="M${r} ${yB} H${xr + q} Q${xr} ${yB} ${xr} ${yB - q} V${yD + q} Q${xr} ${yD} ${xr - q} ${yD} H${br}"/>`;
  }

  function inverter(): string {
    const { cx, cy, half } = BOX;
    return `
      <g class="inverter">
        <rect x="${cx - half}" y="${cy - half}" width="${2 * half}" height="${2 * half}" rx="12"/>
        <g class="icon" transform="translate(${cx - 19} ${cy - 19}) scale(1.6)">
          <rect x="5" y="3" width="14" height="18" rx="2"/><rect x="8" y="6" width="8" height="5" rx="1"/><path d="M8 15h8M8 18h8"/>
        </g>
        <text class="name" x="${cx}" y="${cy + half + 20}" text-anchor="middle">Inverter</text>
      </g>`;
  }

  const root = document.getElementById("flow")!;
  root.innerHTML = `<svg viewBox="0 0 640 430" role="img" aria-label="Power flow">${wires()}${inverter()}${(Object.keys(NODES) as Key[]).map(gauge).join("")}</svg>`;

  const $ = (id: string) => document.getElementById(id)!;
  let gauges = { pv: 5, grid: 12, battery: 5, load: 12 };

  function setGauge(key: Key, value: number | null) {
    const v = Math.abs(value ?? 0);
    const frac = Math.min(1, v / gauges[key]);
    const fill = $(`fill-${key}`);
    fill.setAttribute("stroke-dasharray", `${(frac * ARC_LEN).toFixed(1)} ${ARC_LEN.toFixed(1)}`);
    fill.style.opacity = frac > 0.002 ? "1" : "0"; // a zero-length dash still draws its round cap
    $(`val-${key}`).textContent = value == null ? "–" : v.toFixed(2);
    $(`max-${key}`).textContent = String(gauges[key]);
  }

  function setWire(key: Key, dir: "fwd" | "rev" | "idle") {
    const w = $(`wire-${key}`);
    w.classList.toggle("fwd", dir === "fwd");
    w.classList.toggle("rev", dir === "rev");
  }

  const EPS = 0.03;

  function render(r: Reading | null) {
    setGauge("pv", r?.pv_kw ?? null);
    setGauge("grid", r?.grid_kw ?? null);
    setGauge("battery", r?.battery_kw ?? null);
    setGauge("load", r?.load_kw ?? null);

    const pv = r?.pv_kw ?? 0;
    const grid = r?.grid_kw ?? 0;
    const batt = r?.battery_kw ?? 0;
    const load = r?.load_kw ?? 0;

    setWire("pv", pv > EPS ? "fwd" : "idle");
    setWire("load", load > EPS ? "rev" : "idle");
    setWire("grid", grid > EPS ? "fwd" : grid < -EPS ? "rev" : "idle");
    setWire("battery", batt > EPS ? "fwd" : batt < -EPS ? "rev" : "idle");

    $("name-grid").textContent = grid > EPS ? "Grid · importing" : grid < -EPS ? "Grid · exporting" : "Grid";
    $("name-battery").textContent = batt > EPS ? "Battery · discharging" : batt < -EPS ? "Battery · charging" : "Battery";

    const soc = r?.soc;
    $("soc").textContent = soc == null ? "" : `${Math.round(soc)}%`;
    $("batt-fill").setAttribute("width", String(Math.max(0, Math.min(14, (14 * (soc ?? 0)) / 100))));
    $("batt-fill").setAttribute("fill", soc != null && soc < 20 ? cssVar("--grid") : cssVar("--battery"));
  }

  async function refresh() {
    try {
      const { latest } = await api<{ latest: Reading | null }>("/api/latest");
      render(latest);
      document.dispatchEvent(new CustomEvent("flow:latest", { detail: latest }));
    } catch (e) {
      console.error(e);
    }
  }

  api<AppConfig>("/api/config").then((c) => {
    gauges = c.gauges;
    return refresh();
  });
  setInterval(refresh, 60_000);
  document.addEventListener("flow:refresh", refresh);
</script>
