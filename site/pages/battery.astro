---
import Base from "../layouts/Base.astro";
---
<Base title="Battery" current="battery">
  <h1>Battery</h1>
  <div class="toolbar">
    <label>From <input type="date" id="from" /></label>
    <label>To <input type="date" id="to" /></label>
    <button data-days="30">30 d</button>
    <button data-days="90">90 d</button>
    <button data-days="365">1 y</button>
  </div>
  <div class="tiles" id="tiles"></div>

  <h2>Throughput per day</h2>
  <div class="card">
    <div class="legend">
      <span style="--c: var(--battery-2)">Charged</span>
      <span style="--c: var(--battery)">Discharged</span>
    </div>
    <div id="throughput"></div>
  </div>

  <h2>State of charge range per day</h2>
  <div class="card">
    <div class="legend">
      <span style="--c: var(--soc)">Daily min to max SOC</span>
    </div>
    <div id="soc"></div>
  </div>
</Base>

<script>
  import { api, addDays, cssVar, kwh, qs, setQs, todayIn, type AppConfig, type Daily } from "../lib/api";
  import { barChart } from "../lib/bars";
  import { uPlot, axisStyle, fitWidth, tzDate } from "../lib/charts";

  const cfg = await api<AppConfig>("/api/config");
  const fromEl = document.getElementById("from") as HTMLInputElement;
  const toEl = document.getElementById("to") as HTMLInputElement;
  const today = todayIn(cfg.timezone);
  const socEl = document.getElementById("soc")!;

  const socPlot = new uPlot(
    {
      width: socEl.clientWidth,
      height: 220,
      tzDate: tzDate(cfg.timezone),
      cursor: { points: { size: 8 } },
      axes: [
        { ...axisStyle(), values: (_u, vals) => vals.map((v) => uPlot.fmtDate("{DD}.{MM}")(tzDate(cfg.timezone)(v))) },
        { ...axisStyle(), size: 54, values: (_u, vals) => vals.map((v) => `${v} %`) },
      ],
      scales: { x: { time: true }, y: { range: [0, 100] } },
      series: [
        { label: "Day", value: (_u, v) => (v == null ? "" : uPlot.fmtDate("{YYYY}-{MM}-{DD}")(tzDate(cfg.timezone)(v))) },
        { label: "Max", stroke: cssVar("--soc"), width: 2, points: { show: false }, value: (_u, v) => (v == null ? "–" : `${v.toFixed(0)} %`) },
        { label: "Min", stroke: cssVar("--soc"), width: 2, points: { show: false }, value: (_u, v) => (v == null ? "–" : `${v.toFixed(0)} %`) },
      ],
      bands: [{ series: [1, 2], fill: cssVar("--soc") + "33" }],
    },
    [[], [], []],
    socEl,
  );
  fitWidth(socEl, [socPlot]);

  function tile(label: string, value: string, unit: string, sub = "") {
    return `<div class="tile"><div class="label">${label}</div><div class="value">${value}<small>${unit}</small></div>${sub ? `<div class="sub">${sub}</div>` : ""}</div>`;
  }

  async function load(from: string, to: string) {
    setQs({ from, to });
    fromEl.value = from;
    toEl.value = to;
    const { rows: days } = await api<{ rows: Daily[] }>(`/api/daily?from=${from}&to=${to}`); // one row per day
    const rows = days.filter((d) => d.samples > 0);

    barChart(document.getElementById("throughput")!, {
      labels: rows.map((d) => d.day),
      unit: "kWh",
      series: [
        { name: "Charged", color: "var(--battery-2)", values: rows.map((d) => d.batt_charge_kwh) },
        { name: "Discharged", color: "var(--battery)", values: rows.map((d) => d.batt_discharge_kwh) },
      ],
    });

    // Place each day at local noon so the point sits inside its day on the time axis.
    const noon = rows.map((d) => Date.parse(`${d.day}T12:00:00Z`) / 1000);
    socPlot.setData([noon, rows.map((d) => d.soc_max), rows.map((d) => d.soc_min)]);

    const withSoc = rows.filter((d) => d.soc_min != null);
    const charged = rows.reduce((s, d) => s + d.batt_charge_kwh, 0);
    const discharged = rows.reduce((s, d) => s + d.batt_discharge_kwh, 0);
    const minSoc = withSoc.length ? Math.min(...withSoc.map((d) => d.soc_min as number)) : null;
    const lowDays = withSoc.filter((d) => (d.soc_min as number) <= 20).length;
    document.getElementById("tiles")!.innerHTML = [
      tile("Charged", kwh(charged), "kWh", `${rows.length ? kwh(charged / rows.length) : "–"} kWh/day`),
      tile("Discharged", kwh(discharged), "kWh", `${rows.length ? kwh(discharged / rows.length) : "–"} kWh/day`),
      tile("Round trip", charged > 0 ? `${Math.round((100 * discharged) / charged)}` : "–", "%", "discharged / charged"),
      tile("Lowest SOC", minSoc == null ? "–" : `${Math.round(minSoc)}`, "%", `${lowDays} day${lowDays === 1 ? "" : "s"} at or under 20%`),
    ].join("");
  }

  fromEl.max = toEl.max = today;
  const onChange = () => fromEl.value && toEl.value && fromEl.value <= toEl.value && load(fromEl.value, toEl.value);
  fromEl.addEventListener("change", onChange);
  toEl.addEventListener("change", onChange);
  for (const b of document.querySelectorAll<HTMLButtonElement>("button[data-days]")) {
    b.addEventListener("click", () => load(addDays(today, 1 - Number(b.dataset.days)), today));
  }
  load(qs("from") ?? addDays(today, -29), qs("to") ?? today);
</script>
