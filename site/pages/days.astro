---
import Base from "../layouts/Base.astro";
---
<Base title="Totals" current="days">
  <h1>Daily totals</h1>
  <div class="toolbar">
    <label>From <input type="date" id="from" /></label>
    <label>To <input type="date" id="to" /></label>
    <button data-days="7">7 d</button>
    <button data-days="30">30 d</button>
    <button data-days="90">90 d</button>
  </div>
  <div class="tiles" id="tiles"></div>

  <h2>Energy per day</h2>
  <div class="card">
    <div class="legend">
      <span style="--c: var(--pv)">Solar</span>
      <span style="--c: var(--load)">House</span>
      <span style="--c: var(--battery)">Export</span>
    </div>
    <div id="energy"></div>
  </div>

  <h2>Grid import by tariff zone</h2>
  <div class="card">
    <div class="legend">
      <span style="--c: var(--grid)">Peak</span>
      <span style="--c: var(--grid-2)">Off-peak</span>
    </div>
    <div id="import"></div>
  </div>

  <h2>Table</h2>
  <div class="card table-wrap">
    <table class="data" id="table"></table>
  </div>
</Base>

<script>
  import { api, addDays, kwh, qs, setQs, todayIn, type AppConfig, type Daily } from "../lib/api";
  import { barChart } from "../lib/bars";

  const cfg = await api<AppConfig>("/api/config");
  const fromEl = document.getElementById("from") as HTMLInputElement;
  const toEl = document.getElementById("to") as HTMLInputElement;
  const today = todayIn(cfg.timezone);

  function duration(min: number): string {
    return min >= 60 ? `${Math.floor(min / 60)} h ${String(min % 60).padStart(2, "0")} min` : `${min} min`;
  }

  function fillDays(from: string, to: string, rows: Daily[]): Daily[] {
    const byDay = new Map(rows.map((r) => [r.day, r]));
    const out: Daily[] = [];
    for (let d = from; d <= to; d = addDays(d, 1)) {
      out.push(byDay.get(d) ?? { day: d, pv_kwh: 0, load_kwh: 0, import_peak_kwh: 0, import_offpeak_kwh: 0, export_kwh: 0, batt_charge_kwh: 0, batt_discharge_kwh: 0, soc_min: null, soc_max: null, samples: 0 });
    }
    return out;
  }

  async function load(from: string, to: string) {
    setQs({ from, to });
    fromEl.value = from;
    toEl.value = to;
    const { rows } = await api<{ rows: Daily[] }>(`/api/daily?from=${from}&to=${to}`);
    const days = fillDays(from, to, rows);
    const labels = days.map((d) => d.day);

    barChart(document.getElementById("energy")!, {
      labels,
      unit: "kWh",
      series: [
        { name: "Solar", color: "var(--pv)", values: days.map((d) => d.pv_kwh) },
        { name: "House", color: "var(--load)", values: days.map((d) => d.load_kwh) },
        { name: "Export", color: "var(--battery)", values: days.map((d) => d.export_kwh) },
      ],
    });
    barChart(document.getElementById("import")!, {
      labels,
      unit: "kWh",
      stacked: true,
      series: [
        { name: "Off-peak", color: "var(--grid-2)", values: days.map((d) => d.import_offpeak_kwh) },
        { name: "Peak", color: "var(--grid)", values: days.map((d) => d.import_peak_kwh) },
      ],
    });

    const sum = (f: (d: Daily) => number) => rows.reduce((s, d) => s + f(d), 0);
    const pv = sum((d) => d.pv_kwh);
    const house = sum((d) => d.load_kwh);
    const peak = sum((d) => d.import_peak_kwh);
    const offpeak = sum((d) => d.import_offpeak_kwh);
    const imp = peak + offpeak;
    const exp = sum((d) => d.export_kwh);
    const n = rows.length || 1;
    const tile = (label: string, value: string, unit: string, sub = "") =>
      `<div class="tile"><div class="label">${label}</div><div class="value">${value}<small>${unit}</small></div>${sub ? `<div class="sub">${sub}</div>` : ""}</div>`;
    document.getElementById("tiles")!.innerHTML = [
      tile("Solar", kwh(pv), "kWh", `${kwh(pv / n)} kWh/day`),
      tile("House", kwh(house), "kWh", `${kwh(house / n)} kWh/day`),
      tile("Grid import", kwh(imp), "kWh", `${imp > 0 ? Math.round((100 * peak) / imp) : 0}% in peak hours`),
      tile("Grid export", kwh(exp), "kWh", `${kwh(exp / n)} kWh/day`),
      tile("Self-sufficiency", house > 0 ? String(Math.round((100 * Math.max(0, house - imp)) / house)) : "–", "%", "house load not from the grid"),
    ].join("");
    const cols: [string, (d: Daily) => string][] = [
      ["Solar", (d) => kwh(d.pv_kwh)],
      ["House", (d) => kwh(d.load_kwh)],
      ["Import peak", (d) => kwh(d.import_peak_kwh)],
      ["Import off-peak", (d) => kwh(d.import_offpeak_kwh)],
      ["Export", (d) => kwh(d.export_kwh)],
      ["Batt in", (d) => kwh(d.batt_charge_kwh)],
      ["Batt out", (d) => kwh(d.batt_discharge_kwh)],
      ["SOC min", (d) => (d.soc_min == null ? "–" : `${Math.round(d.soc_min)}%`)],
      ["Missing", (d) => (d.missing_min ? duration(d.missing_min) : "–")],
    ];
    const totals = [
      kwh(sum((d) => d.pv_kwh)), kwh(sum((d) => d.load_kwh)), kwh(sum((d) => d.import_peak_kwh)), kwh(sum((d) => d.import_offpeak_kwh)),
      kwh(sum((d) => d.export_kwh)), kwh(sum((d) => d.batt_charge_kwh)), kwh(sum((d) => d.batt_discharge_kwh)), "", "",
    ];
    document.getElementById("table")!.innerHTML =
      `<thead><tr><th>Day</th>${cols.map(([h]) => `<th>${h}</th>`).join("")}</tr></thead>` +
      `<tbody>${[...rows].reverse().map((d) => `<tr><td><a href="/day?date=${d.day}">${d.day}</a></td>${cols.map(([, f]) => `<td>${f(d)}</td>`).join("")}</tr>`).join("")}</tbody>` +
      `<tfoot><tr><td>Total (kWh)</td>${totals.map((t) => `<td>${t}</td>`).join("")}</tr></tfoot>`;
  }

  fromEl.max = toEl.max = today;
  const onChange = () => fromEl.value && toEl.value && fromEl.value <= toEl.value && load(fromEl.value, toEl.value);
  fromEl.addEventListener("change", onChange);
  toEl.addEventListener("change", onChange);
  for (const b of document.querySelectorAll<HTMLButtonElement>("button[data-days]")) {
    b.addEventListener("click", () => load(addDays(today, 1 - Number(b.dataset.days)), today));
  }
  load(qs("from") ?? addDays(today, -29), qs("to") ?? today);
</script>
