{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deyecloud-browser",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  // Astro build output, served by the same Worker as the API so one Access policy covers both.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Deye loggers upload every 5 minutes; polling faster is waste.
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deyecloud-browser",
      "database_id": "deyecloud-browser"
    }
  ],
  "vars": {
    "ALLOW_PUBLIC": "false",
    "SITE_TITLE": "",
    "DEYE_BASE_URL": "https://eu1-developer.deyecloud.com",
    "DEYE_POWER_UNIT": "W",
    "STATION_NAME": "",
    "BACKFILL_FROM": "",
    "TIMEZONE": "Europe/Warsaw",
    "OFFPEAK_HOURS": "22-6,13-15",
    "GAUGE_PV_KW": "5",
    "GAUGE_GRID_KW": "12",
    "GAUGE_BATTERY_KW": "5",
    "GAUGE_LOAD_KW": "12"
  },
  // Secrets, set with `wrangler secret put` or in the dashboard:
  // DEYE_APP_ID, DEYE_APP_SECRET, DEYE_EMAIL, DEYE_PASSWORD
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // Simulates a signed-in Cloudflare Access user for `wrangler dev`.
  "access": {
    "dev": {
      "aud": "local-dev",
      "identity": {
        "email": "dev@example.com"
      }
    }
  }
}